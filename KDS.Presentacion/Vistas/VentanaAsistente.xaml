<Window x:Class="KDS.PRE.Vistas.VentanaAsistente"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MESALINK — Asistente" Icon="/Assets/logo-kdss.png"
        Width="560" Height="760" MinWidth="420" MinHeight="480"
        WindowStartupLocation="CenterOwner" Background="#080808">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="TextoRol" Text="ASISTENTE" Foreground="#AAAAAA" FontSize="11" FontWeight="Bold"/>
                <TextBlock Text="¿En qué te ayudo?" Foreground="White" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,0"/>
                <TextBlock x:Name="TextoModo" Foreground="#888888" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                <CheckBox x:Name="ChkVoz" Content="🔊 Leer en voz alta" Foreground="#CCCCCC" FontSize="12"
                          Margin="0,0,0,8" Checked="ChkVoz_Cambio" Unchecked="ChkVoz_Cambio"/>
                <Button Content="NUEVA CONVERSACIÓN" Click="BtnNueva_Click" Style="{StaticResource Boton}"
                        Height="30" Padding="10,0" FontSize="11"/>
                <Button Content="✕ SALIR" Click="BtnSalir_Click" Style="{StaticResource Boton}"
                        Height="30" Padding="10,0" FontSize="11" Foreground="#FF6464" Margin="0,8,0,0"/>
            </StackPanel>
        </Grid>

        <WrapPanel x:Name="PanelAtajos" Grid.Row="1" Margin="0,0,0,10"/>

        <Border Grid.Row="2" Background="#101010" BorderBrush="#333333" BorderThickness="1" CornerRadius="10">
            <ScrollViewer x:Name="Desplazador" VerticalScrollBarVisibility="Auto" Padding="12">
                <StackPanel x:Name="PanelChat"/>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="110"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TxtPregunta" Style="{StaticResource Campo}" Margin="0" MaxLength="1500"
                     TextWrapping="Wrap" AcceptsReturn="False" MinHeight="40" MaxHeight="120"
                     VerticalScrollBarVisibility="Auto" PreviewKeyDown="TxtPregunta_KeyDown"/>
            <Button x:Name="BtnEnviar" Grid.Column="2" Content="ENVIAR" Click="BtnEnviar_Click" Style="{StaticResource Boton}"
                    Background="#F5A623" BorderBrush="#F5A623" Foreground="#111111"/>
        </Grid>
    </Grid>
</Window>
